# Bu fayl docker-compose.yml bilan bir joyda (loyiha ildizida) turadi.
# Nusxa oling: cp .env.example .env  — va qiymatlarni to'ldiring.
# ("backend/.env" — bu faqat lokal (docker'siz) ishga tushirish uchun, docker-compose buni o'qimaydi.)

# --- MAJBURIY: quyidagi ikkita kalitni o'zingiz generatsiya qiling ---
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_RANDOM_LONG_STRING

# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

# --- Ixtiyoriy ---
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEFAULT_SUPERADMIN_USERNAME=
DEFAULT_SUPERADMIN_PASSWORD=
INACTIVITY_TIMEOUT_SECONDS=60

# --- Brute-force himoyasi (ixtiyoriy, bo'sh qoldirsangiz standart qiymatlar ishlaydi) ---
LOGIN_RATE_LIMIT=5/minute
FORGOT_PASSWORD_RATE_LIMIT=3/hour
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15

# --- "Parolni unutdim" kalit so'zi ---
# MUHIM: bu funksiya ishlashi uchun quyiga o'z kalit so'zingizni yozing.
# Bo'sh qoldirilsa — kalit so'z tekshirilmaydi (istalgan qiymat o'tadi).
FORGOT_PASSWORD_SECRET=

# --- Telegram bot ("Parolni unutdim" uchun) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
