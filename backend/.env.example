# SQLite (default, ishga tayyor, hech narsa o'rnatish shart emas):
DATABASE_URL=sqlite:///./app.db

# PostgreSQL ishlatmoqchi bo'lsangiz (loyihangizning odatiy stacki), buni yoqing:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/credvault

SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

DEFAULT_SUPERADMIN_USERNAME=
DEFAULT_SUPERADMIN_PASSWORD=

INACTIVITY_TIMEOUT_SECONDS=60

# Telegram bot ("Parolni unutdim" funksiyasi uchun).
# Bo'sh qoldirilsa, xabar yuborilmaydi - o'rniga backend konsoliga (log) chiqariladi (dev rejimi uchun qulay).
# Botni @BotFather orqali yarating, TOKEN'ni shu yerga qo'ying.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
